{
	"name": "youtube-stutter",
	"version": "0.1.0",
	"description": "",
	"type": "module",
	"scripts": {
		"build": "wireit",
		"build:ts": "wireit",
		"build:content": "wireit"
	},
	"wireit": {
		"build": {
			"command": "npx @vdegenne/bip && notify-send -t 1000 \"Build done\"",
			"dependencies": [
				"build:content",
				"build:ts",
				"build:rollup",
				"pwa-assets"
			],
			"files": [],
			"output": []
		},
		"build:ts": {
			"command": "tsc -p ./tsconfig.background.json",
			"clean": "if-file-deleted",
			"files": [
				"./tsconfig.background.json",
				"./src/background.ts",
				"./src/debug.ts"
			],
			"output": [
				"./lib/"
			]
		},
		"build:content": {
			"command": "vite build --config ./vite.content.config.js",
			"files": [
				"./vite.content.config.js",
				"./src/",
				"!./src/UI/",
				"!./src/background.ts"
			],
			"output": [
				"./content.js"
			]
		},
		"build:rollup": {
			"command": "rollup -c",
			"dependencies": [
				"build:ts"
			],
			"files": [
				"./rollup.config.js",
				"./lib/"
			],
			"output": [
				"./background.js"
			]
		},
		"build:options": {
			"command": "vite build documents/options --config ./vite.config.js",
			"files": [
				"./vite.config.js",
				"./src/UI/**/*",
				"./documents/options/index.html"
			],
			"output": [
				"./documents/options/dist/"
			]
		},
		"build:popup": {
			"command": "vite build documents/popup --config ./vite.config.js",
			"files": [
				"./vite.config.js",
				"./src/UI/**/*",
				"./documents/popup/index.html"
			],
			"output": [
				"./documents/popup/dist/"
			]
		},
		"build:offscreen": {
			"command": "vite build documents/offscreen --config ./vite.config.js",
			"files": [
				"./vite.config.js",
				"./src/UI/**/*",
				"./documents/offscreen/index.html"
			],
			"output": [
				"./documents/offscreen/dist/"
			]
		},
		"build:sidepanel": {
			"command": "vite build documents/sidepanel --config ./vite.config.js",
			"files": [
				"./vite.config.js",
				"./src/UI/**/*",
				"./documents/sidepanel/index.html"
			],
			"output": [
				"./documents/sidepanel/dist/"
			]
		},
		"pwa-assets": {
			"command": "pwa-assets-generator --preset minimal-2023 --html.preset 2025 ./assets/img/logo.svg && node ./scripts/generate-128-icon.js",
			"files": [
				"./scripts/generate-128-icon.js",
				"./assets/img/logo.svg"
			],
			"output": [
				"./assets/img/pwa-64x64.png",
				"./assets/img/pwa-192x192.png",
				"./assets/img/pwa-512x512.png",
				"./assets/img/maskable-icon-512x512.png",
				"./assets/img/apple-touch-icon-180x180.png",
				"./assets/img/favicon.ico",
				"./assets/img/chrome-store-128x128.png"
			]
		}
	},
	"devDependencies": {
		"@material/mwc-snackbar": "^0.27.0",
		"@material/web": "^2.5.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@snar/lit": "^1.8.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/chrome": "^0.2.8",
		"@vdegenne/chrome-extension": "^0.1.23",
		"@vdegenne/forms": "^0.1.74",
		"@vdegenne/material-color-helpers": "^1.11.7",
		"@vdegenne/rollup": "^0.1.18",
		"@vdegenne/rollup-plugin-minify-html": "^1.0.6",
		"@vdegenne/vite-plugin-css-modules": "^0.1.12",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@webcomponents/webcomponentsjs": "^2.8.0",
		"custom-element-decorator": "^0.6.0",
		"lit": "^3.3.3",
		"lit-with-styles": "^2.1.3",
		"material-all-mangle-names": "^0.1.5",
		"material-shell": "^1.3.10",
		"rollup-plugin-material-all": "^1.2.3",
		"rollup-plugin-minify-template-literals": "^2.2.0",
		"sharp": "^0.35.4",
		"snar-save-to-local-storage": "^1.0.1",
		"toastit": "^2.2.5",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vite-plugin-mdicon2svg": "^0.2.4",
		"wireit": "^0.14.13"
	}
}
