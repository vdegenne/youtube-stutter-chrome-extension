{
	"manifest_version": 3,
	"name": "youtube-stutter",
	"version": "0.1",
	"permissions": [
		// "offscreen",
		// "storage",
		// "alarms",
		// "notifications",
		// "sidePanel",
		"scripting",
		"tabs"
	],
	"host_permissions": ["https://www.youtube.com/"],
	"background": {
		"service_worker": "./background.js"
	},
	/*"content_scripts": [
		{
			"matches": ["https://www.youtube.com/*"],
			"js": [
				// "./inject-content.js",
				"./content.js"
			],
			"run_at": "document_end",
			"all_frames": false
		}
